<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">M3 Home</string>
    <string name="guard_name">M3 Home: Home button</string>
    <string name="guard_desc">Opens M3 Home when you press Home, opens M3 Home settings when you hold Home, and draws the brightness and blue light filter. It only watches Amazon\'s launcher and settings windows and reads no screen content.</string>

    <!-- Material 3 dark, baseline purple -->
    <color name="m3_background">#FF141218</color>

    <style name="M3Home" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/m3_background</item>
        <item name="android:colorBackground">#FF141218</item>
        <item name="android:colorAccent">#FFD0BCFF</item>
        <item name="android:colorPrimary">#FF141218</item>
        <item name="android:colorPrimaryDark">#FF141218</item>
        <item name="android:textColorPrimary">#FFE6E0E9</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>

    <!-- Side sheet over a dimmed screen -->
    <style name="M3Panel" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@color/m3_scrim</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:colorAccent">#FFD0BCFF</item>
        <item name="android:textColorPrimary">#FFE6E0E9</item>
    </style>
    <color name="m3_scrim">#8C0B0A0F</color>

    <style name="M3Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorBackground">#FF2B2930</item>
        <item name="android:colorAccent">#FFD0BCFF</item>
        <item name="android:colorControlHighlight">#40D0BCFF</item>
        <item name="android:textColorPrimary">#FFE6E0E9</item>
        <item name="android:textColorSecondary">#FFCAC4D0</item>
        <item name="android:textColorAlertDialogListItem">#FFE6E0E9</item>
    </style>
</resources>
